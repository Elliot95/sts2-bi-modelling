model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_run","dim_card","dim_relic","dim_date","fct_floor_state","fct_card_choice","fct_card_run","fct_card_gained","fct_run_relic","fct_run_deck_card","dim_event","fct_event_choice","event_image"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_run
ref table dim_card
ref table dim_relic
ref table dim_date
ref table fct_floor_state
ref table fct_card_choice
ref table fct_card_run
ref table fct_card_gained
ref table fct_run_relic
ref table fct_run_deck_card
ref table dim_event
ref table fct_event_choice
ref table event_image

