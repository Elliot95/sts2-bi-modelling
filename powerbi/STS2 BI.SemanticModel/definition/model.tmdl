model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["fact_run","fact_floor_state","fact_card_choice","fact_cards_gained","fact_relic","fact_deck_card","dim_date","dim_card","dim_relic"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fact_run
ref table fact_floor_state
ref table fact_card_choice
ref table fact_cards_gained
ref table fact_relic
ref table fact_deck_card
ref table dim_date
ref table dim_card
ref table dim_relic

