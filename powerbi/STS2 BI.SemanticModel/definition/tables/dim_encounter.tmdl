table dim_encounter
	lineageTag: 30e6534d-c9a8-4fe6-b43c-89c0b3dc61ab

	measure 'Death Line' = VAR t = SELECTEDVALUE(dim_encounter[loss_text]) VAR n = SELECTEDVALUE(dim_encounter[encounter_name]) VAR ch = IF(HASONEVALUE(dim_run[character_name]), VALUES(dim_run[character_name]), "Ironclad") RETURN IF(ISBLANK(t), "Click an encounter in the table to see how the game describes losing to it.", SUBSTITUTE(SUBSTITUTE(t, "{encounter}", n), "{character}", ch))
		lineageTag: 6e427f96-2fa1-4cf4-a5ae-b6b165a74a75

