	partition fct_potion_run = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="sts2-bi-1995ebj"]),
				    #"sts2-bi-1995ebj" = Source{[Name="sts2-bi-1995ebj"]}[Data],
				    marts = #"sts2-bi-1995ebj"{[Name="sts2_marts",Kind="Schema"]}[Data],
				    fct_potion_run_Table = marts{[Name="fct_potion_run",Kind="Table"]}[Data]
				in
