table dim_relic

	column relic_id
		dataType: string
		summarizeBy: none
		sourceColumn: relic_id

		annotation SummarizationSetBy = User

	column relic_name
		dataType: string
		summarizeBy: none
		sourceColumn: relic_name

		annotation SummarizationSetBy = User

	column first_seen_run_id
		dataType: int64
		summarizeBy: none
		sourceColumn: first_seen_run_id

		annotation SummarizationSetBy = User

	column first_seen_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: first_seen_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition dim_relic = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="sts2-bi-1995ebj"]),
				    #"sts2-bi-1995ebj" = Source{[Name="sts2-bi-1995ebj"]}[Data],
				    marts = #"sts2-bi-1995ebj"{[Name="sts2_marts",Kind="Schema"]}[Data],
				    dim_relic_Table = marts{[Name="dim_relic",Kind="Table"]}[Data]
				in
				    dim_relic_Table

	annotation PBI_ResultType = Table

