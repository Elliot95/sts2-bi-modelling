table fact_card_choice
	lineageTag: 7ba9a0b4-9e27-4b9c-b1b3-34c9c9fe8561

	measure 'Card Pick Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_card_choice), fact_card_choice[was_picked] = TRUE), COUNTROWS(fact_card_choice))
		lineageTag: 16161f53-eb7b-4f3f-bdd7-3edd6ac55277

	measure 'Win Rate When Picked' = CALCULATE([Win Rate], TREATAS(CALCULATETABLE(VALUES(fact_card_choice[run_id]), fact_card_choice[was_picked] = TRUE), fact_run[run_id]))
		lineageTag: 49bfa295-db65-47ce-b394-68a86293475c

