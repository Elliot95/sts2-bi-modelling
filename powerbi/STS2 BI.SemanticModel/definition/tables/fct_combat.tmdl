table fct_combat
	lineageTag: 386dc36c-624d-454f-b21c-6721e6af00bb

	measure Fights = COUNTROWS(fct_combat)
		formatString: #,0
		lineageTag: b88da7aa-96f3-4687-9ef2-23a0a123160f

	measure 'Fight Deaths' = CALCULATE(COUNTROWS(fct_combat), fct_combat[died_here] = TRUE)
		formatString: #,0
		lineageTag: 3c8e103d-746c-4ff6-905b-8074eff49852

	measure 'Fight Death Rate' = DIVIDE([Fight Deaths] + 0, [Fights])
		formatString: 0.0%
		lineageTag: 502fe5c9-36e6-4b08-8f9f-e173c434d4ab

	measure 'Avg Turns' = AVERAGE(fct_combat[turns_taken])
		formatString: 0.0
		lineageTag: a9fd4d6a-a376-4622-a2cf-876e224e2778

	measure 'Avg Damage % Max HP' = AVERAGE(fct_combat[damage_pct_of_max])
		formatString: 0.0%
		lineageTag: 64c4732b-28aa-4047-b48c-9fc1b3a15fdd

	measure 'Avg Potions In Fight' = AVERAGE(fct_combat[potions_used])
		formatString: 0.00
		lineageTag: 438de410-e737-4a1c-adb4-7eb10c688ac9

	measure 'Avg HP Going In' = AVERAGE(fct_combat[hp_pct_before])
		formatString: 0%
		lineageTag: 38b4ff32-9c58-45ec-a534-d40f38e5b36d

	measure 'HP Going Into Fatal Fights' = CALCULATE(AVERAGE(fct_combat[hp_pct_before]), fct_combat[died_here] = TRUE)
		formatString: 0%
		lineageTag: 3f671b1c-214c-44da-b92c-9a0612ecfc0a

	measure 'Death Rate Font Color' = VAR r = [Fight Death Rate] VAR overall = CALCULATE([Fight Death Rate], REMOVEFILTERS(dim_encounter)) RETURN IF(ISBLANK(r), BLANK(), IF(r <= overall, "#4ade80", "#f87171"))
		lineageTag: bab2db03-3ea2-4008-964a-516700b4962a

