table fct_card_run
	lineageTag: c8dfaae8-f8ac-4c26-ae7d-bb247d2ab530

	measure 'Runs Offered' = COUNTROWS(fct_card_run)
		formatString: #,0
		lineageTag: 95bb7f08-fcf2-4f55-ac37-ef018cb79b1f

	measure 'Runs Picked' = CALCULATE(COUNTROWS(fct_card_run), fct_card_run[was_picked] = TRUE)
		formatString: #,0
		lineageTag: fbcb304a-d7b0-4085-93ad-a4d66e37f6ec

	measure 'Runs Skipped' = CALCULATE(COUNTROWS(fct_card_run), fct_card_run[was_picked] = FALSE)
		formatString: #,0
		lineageTag: bcbd7a14-66bf-4322-a90f-7227b6eed85d

	measure 'Run Pick Rate' = DIVIDE([Runs Picked], [Runs Offered])
		formatString: 0.0%
		lineageTag: 6ad57396-ad2f-4db4-a11f-178c90a2aa48

	measure 'Win Rate Picked' = DIVIDE(CALCULATE([Runs Picked], dim_run[win] = TRUE), [Runs Picked])
		formatString: 0.0%
		lineageTag: 506a9b57-8b0f-448a-ace2-2e4750ce55ef

	measure 'Win Rate Skipped' = DIVIDE(CALCULATE([Runs Skipped], dim_run[win] = TRUE), [Runs Skipped])
		formatString: 0.0%
		lineageTag: 2460ab05-99f8-4b17-b997-54d3911ef483

	measure 'Pick Win Delta' = IF([Runs Picked] > 0 && [Runs Skipped] > 0, [Win Rate Picked] - [Win Rate Skipped])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: c824930a-afab-446a-bbf5-768fe55a4598

	measure 'Delta Font Color' = SWITCH(TRUE(), ISBLANK([Pick Win Delta]), BLANK(), [Pick Win Delta] > 0, "#15803d", [Pick Win Delta] < 0, "#b91c1c", "#374151")
		lineageTag: 267b8e73-899e-4c0e-be55-9f94704bf5b9

	measure 'Picked Font Color' = IF(ISBLANK([Win Rate Picked]) || ISBLANK([Win Rate Skipped]), BLANK(), IF([Win Rate Picked] >= [Win Rate Skipped], "#15803d", "#b91c1c"))
		lineageTag: e0e05da9-10d6-4a51-a24f-42483e838d0d

