table fact_run
	lineageTag: 794f3c83-1115-402b-aeb8-48e725efe6f3

	measure 'Total Runs' = COUNTROWS(fact_run)
		lineageTag: a3772e57-d4b0-4830-aae0-494012b2321a

	measure 'Win Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_run), fact_run[win] = TRUE), [Total Runs])
		lineageTag: 85bfd250-4418-4325-98e3-ba34ae498c11

	measure 'Avg Floors Reached' = AVERAGE(fact_run[acts_completed])
		lineageTag: 19ed7312-1e91-4c64-a174-e67a63b558ad

