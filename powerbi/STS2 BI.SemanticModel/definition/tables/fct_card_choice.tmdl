table fct_card_choice
	lineageTag: a4fe55ed-a64b-470f-812e-63f2de71c35b

	measure 'Times Offered' = COUNTROWS(fct_card_choice)
		formatString: #,0
		lineageTag: 582c5c3d-f14a-4e9a-8596-47c196e3ad5a

	measure 'Times Picked' = CALCULATE(COUNTROWS(fct_card_choice), fct_card_choice[was_picked] = TRUE)
		formatString: #,0
		lineageTag: a367dd07-f88e-47d3-96b0-3c8b4da266b4

	measure 'Card Pick Rate' = DIVIDE([Times Picked], [Times Offered])
		formatString: 0.0%
		lineageTag: ae6e8292-e1ce-4f76-9f18-70cba787c785

	measure 'Win Rate When Picked' = CALCULATE([Win Rate], TREATAS(CALCULATETABLE(VALUES(fct_card_choice[run_id]), fct_card_choice[was_picked] = TRUE), dim_run[run_id]))
		formatString: 0.0%
		lineageTag: 2d873c9c-b1e0-4485-99a2-57c03ca749c5

	column run_id
		dataType: int64
		isHidden
