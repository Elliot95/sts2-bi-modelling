table fct_rest_choice
	lineageTag: 1537157c-d91f-4403-9476-20d9b81b2e44

	measure 'Rest Choices' = COUNTROWS(fct_rest_choice)
		formatString: #,0
		lineageTag: 09be4a18-0e46-4fc8-8938-9d4695b70fb0

	measure 'Rest Share' = DIVIDE(CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] = "HEAL"), CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] IN {"HEAL", "SMITH"}))
		formatString: 0.0%
		lineageTag: da1f15b8-a19e-4fd5-9543-2653e1cb73a1

	measure 'Died Next Act After Rest' = DIVIDE(CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] = "HEAL", fct_rest_choice[died_before_next_act] = TRUE), CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] = "HEAL"))
		formatString: 0.0%
		lineageTag: 1d22f31c-a66d-4a33-a249-66dcc4db4000

	measure 'Died Next Act After Smith' = DIVIDE(CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] = "SMITH", fct_rest_choice[died_before_next_act] = TRUE), CALCULATE(COUNTROWS(fct_rest_choice), fct_rest_choice[rest_option] = "SMITH"))
		formatString: 0.0%
		lineageTag: cf80d79e-a26e-477f-a3af-5e15836e60d1

