table fct_event_choice
	lineageTag: 3abf5c9a-0d5b-4eda-87fb-84ac9aebcfb5

	measure Choices = COUNTROWS(fct_event_choice)
		formatString: #,0
		lineageTag: f12f1c99-cdae-4194-ac83-e37c0e72dc7f

	measure 'Event Runs' = DISTINCTCOUNT(fct_event_choice[run_id])
		formatString: #,0
		lineageTag: 72db0249-a0e1-4599-82e7-80d04e320259

	measure 'Option Share' = DIVIDE([Choices], CALCULATE([Choices], REMOVEFILTERS(fct_event_choice[option_name], fct_event_choice[choice_key], fct_event_choice[option_code], fct_event_choice[option_page], fct_event_choice[relic_id], fct_event_choice[option_description])))
		formatString: 0.0%
		lineageTag: fb494bca-f994-4dc5-8f3c-ad7335d77ca0

	measure 'Choice Win Rate' = DIVIDE(CALCULATE([Choices], fct_event_choice[win] = TRUE), CALCULATE([Choices], fct_event_choice[outcome] <> "Abandoned"))
		formatString: 0.0%
		lineageTag: 61f9b4a2-36b6-4c62-b2e0-15d9579d8f23

	measure 'Died Before Next Act %' = DIVIDE(CALCULATE([Choices], fct_event_choice[died_before_next_act] = TRUE), [Choices])
		formatString: 0.0%
		lineageTag: 144370a4-f522-46cb-ba18-53a8f465e26a

	measure 'Died Within 3 Floors %' = DIVIDE(CALCULATE([Choices], fct_event_choice[died_within_3_floors] = TRUE), [Choices])
		formatString: 0.0%
		lineageTag: 1d747187-972b-42c8-960a-20a13a925e72

	measure 'Avg Floors Survived After' = AVERAGE(fct_event_choice[floors_survived_after])
		formatString: 0.0
		lineageTag: e6d84d1d-6f32-4be9-8bac-9e3ff5d8d257

	measure 'Avg HP Change' = ROUND(AVERAGE(fct_event_choice[hp_change]), 1)
		formatString: +0.0;-0.0;0.0
		lineageTag: d791e711-d3da-4935-9dd2-54dccca1be5d

	measure 'Avg Max HP Change' = ROUND(AVERAGE(fct_event_choice[max_hp_change]), 1)
		formatString: +0.0;-0.0;0.0
		lineageTag: 3da4d333-d94b-42dd-b2b9-5b471bb2a093

	measure 'Avg Gold Change' = ROUND(AVERAGE(fct_event_choice[gold_change]), 0)
		formatString: +0;-0;0
		lineageTag: a6762bca-9dc9-4be1-9c25-1c21166da39f

	measure 'Choice Win Font Color' = VAR r = [Choice Win Rate] VAR evt = CALCULATE([Choice Win Rate], REMOVEFILTERS(fct_event_choice[option_name], fct_event_choice[choice_key], fct_event_choice[option_code], fct_event_choice[option_page], fct_event_choice[relic_id], fct_event_choice[option_description])) RETURN IF(ISBLANK(r), BLANK(), IF(r >= evt, "#4ade80", "#f87171"))
		lineageTag: 8fa77e75-d16e-433f-b64f-cdc11e218bfa

	measure 'Death Font Color' = VAR r = [Died Before Next Act %] VAR evt = CALCULATE([Died Before Next Act %], REMOVEFILTERS(fct_event_choice[option_name], fct_event_choice[choice_key], fct_event_choice[option_code], fct_event_choice[option_page], fct_event_choice[relic_id], fct_event_choice[option_description])) RETURN IF(ISBLANK(r), BLANK(), IF(r <= evt, "#4ade80", "#f87171"))
		lineageTag: b8047176-5267-4381-a698-ea85f60c3560

	measure 'Event Description' = SELECTEDVALUE(dim_event[description], "Select an event to read its opening text.")
		lineageTag: d61c9eae-27e2-40b2-b90b-7d8b9eb20d30

	measure 'Selected Event' = SELECTEDVALUE(dim_event[event_name], "All events")
		lineageTag: 77960f30-94a1-4b0e-92bd-2d2f733ba2e2

