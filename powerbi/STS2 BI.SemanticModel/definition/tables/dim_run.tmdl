table dim_run
	lineageTag: 580eade7-beba-4cca-a733-3b827140dd3d

	measure 'Total Runs' = COUNTROWS(dim_run)
		formatString: #,0
		lineageTag: 6b483153-e57b-4423-b72e-42a06ceb7c6e

	measure Wins = CALCULATE([Total Runs], dim_run[win] = TRUE)
		formatString: #,0
		lineageTag: 28ea17d5-f848-461d-bf01-554c3015b3fc

	measure 'Win Rate' = DIVIDE([Wins], [Total Runs])
		formatString: 0.0%
		lineageTag: de085cb5-e28c-4412-99fb-498804a13525

	measure 'Avg Floors Reached' = AVERAGE(dim_run[floors_reached])
		formatString: 0.0
		lineageTag: 15f52072-7778-4692-a61a-e2a0b5a8e61e

	measure 'Avg Death Floor' = AVERAGE(dim_run[death_floor])
		formatString: 0.0
		lineageTag: 31daf419-a67d-4ee5-b834-0927336fc5a6

	measure Losses = CALCULATE([Total Runs], dim_run[outcome] = "Lost")
		formatString: #,0
		lineageTag: aa97b787-e8b5-49b9-a6d7-e1069199d750

	measure 'Abandoned Runs' = CALCULATE([Total Runs], dim_run[outcome] = "Abandoned")
		formatString: #,0
		lineageTag: 082dec7f-172e-4d8f-a2fb-fb77ac7c3130

	measure 'Win Rate (Completed)' = DIVIDE([Wins], [Total Runs] - [Abandoned Runs])
		formatString: 0.0%
		lineageTag: 58e71373-3243-45a9-8efc-1ceac0b99a89

	measure 'Character Color' = SELECTEDVALUE(dim_run[character_color], "#64748b")
		lineageTag: 23a09d6c-7509-4a39-94c5-d247ba7ff894

	measure 'Character Row Color' = SELECTEDVALUE(dim_run[character_color_tint], "#ffffff")
		lineageTag: ffb3b050-ef32-4802-b8b9-8a25c9d7d403

	measure 'Win Rate Font Color' = VAR r = [Win Rate (Completed)] VAR overall = CALCULATE([Win Rate (Completed)], ALL(dim_run)) RETURN IF(ISBLANK(r), BLANK(), IF(r >= overall, "#15803d", "#b91c1c"))
		lineageTag: 8f10db5f-1669-496b-8d03-394681bada1f

	measure 'Floors Font Color' = VAR f = [Avg Floors Reached] VAR overall = CALCULATE([Avg Floors Reached], ALL(dim_run)) RETURN IF(ISBLANK(f), BLANK(), IF(f >= overall, "#15803d", "#b91c1c"))
		lineageTag: 295bea7a-f891-4456-b601-0090cfd1ce4f

