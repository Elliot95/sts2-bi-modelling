table fct_run_relic

	column run_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = User

	column player_id
		dataType: int64
		summarizeBy: none
		sourceColumn: player_id

		annotation SummarizationSetBy = User

	column relic_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: relic_id

		annotation SummarizationSetBy = User

	column floor_added_to_deck
		dataType: int64
		summarizeBy: none
		sourceColumn: floor_added_to_deck

		annotation SummarizationSetBy = User

	partition fct_run_relic = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="sts2-bi-1995ebj"]),
				    #"sts2-bi-1995ebj" = Source{[Name="sts2-bi-1995ebj"]}[Data],
				    marts = #"sts2-bi-1995ebj"{[Name="sts2_marts",Kind="Schema"]}[Data],
				    fct_run_relic_Table = marts{[Name="fct_run_relic",Kind="Table"]}[Data]
				in
				    fct_run_relic_Table

	annotation PBI_ResultType = Table

