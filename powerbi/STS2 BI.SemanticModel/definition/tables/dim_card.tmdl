table dim_card

	column card_id
		dataType: string
		summarizeBy: none
		sourceColumn: card_id

		annotation SummarizationSetBy = User

	column card_name
		dataType: string
		summarizeBy: none
		sourceColumn: card_name

		annotation SummarizationSetBy = User

	column first_seen_run_id
		dataType: int64
		summarizeBy: none
		sourceColumn: first_seen_run_id

		annotation SummarizationSetBy = User

	column first_seen_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: first_seen_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition dim_card = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="sts2-bi-1995ebj"]),
				    #"sts2-bi-1995ebj" = Source{[Name="sts2-bi-1995ebj"]}[Data],
				    marts = #"sts2-bi-1995ebj"{[Name="sts2_marts",Kind="Schema"]}[Data],
				    dim_card_Table = marts{[Name="dim_card",Kind="Table"]}[Data]
				in
