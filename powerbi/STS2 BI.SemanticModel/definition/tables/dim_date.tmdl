table dim_date
	dataCategory: Time

	column date_key
		dataType: dateTime
		formatString: Short Date
		isKey
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = User

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name

		annotation SummarizationSetBy = User

	column day
		dataType: int64
		summarizeBy: none
		sourceColumn: day

		annotation SummarizationSetBy = User

	column day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = User

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

		annotation SummarizationSetBy = User

	column week_of_year
		dataType: int64
		summarizeBy: none
		sourceColumn: week_of_year

		annotation SummarizationSetBy = User

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = User

	partition dim_date = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject="sts2-bi-1995ebj"]),
				    #"sts2-bi-1995ebj" = Source{[Name="sts2-bi-1995ebj"]}[Data],
				    marts = #"sts2-bi-1995ebj"{[Name="sts2_marts",Kind="Schema"]}[Data],
				    dim_date_Table = marts{[Name="dim_date",Kind="Table"]}[Data]
				in
				    dim_date_Table

	annotation PBI_ResultType = Table

